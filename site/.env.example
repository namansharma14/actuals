# Copy to .env.local, or run `vercel env pull .env.local --environment=preview`.
# Every surface degrades to a sentence when its keys are missing, so a deployment with
# none of these still serves the landing page, /demo and the report.

# Neon Postgres. Everything this app writes lives in the `hosted` schema.
DATABASE_URL=

# Vercel Blob. The store on this project is private; the app streams the files back.
BLOB_READ_WRITE_TOKEN=

# Clerk, GitHub as the social provider. Test instance for preview, production for prod.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe. Without a price id, that tier's button reads "checkout not configured on this
# deployment" and is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_RUN=

# Optional. The origin used in share links; falls back to VERCEL_URL, then the request.
SITE_ORIGIN=
