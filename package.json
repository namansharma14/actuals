{
  "name": "actuals",
  "version": "0.1.3",
  "description": "See what your coding agents actually shipped. Reads your Claude Code sessions and git, locally, and reports what was kept, what died, and what it cost.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namansharma14/actuals.git"
  },
  "bin": {
    "actuals": "dist/cli.js"
  },
  "files": [
    "dist",
    "rates.json",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "gates": "tsx eval/harness.ts",
    "eval": "tsx eval/harness.ts --score",
    "accept": "tsx eval/accept.ts",
    "check": "npm run lint && npm run types && npm run test && npm run gates -- --check",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.12.0",
    "smol-toml": "^1.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  },
  "homepage": "https://getactuals.net"
}
